generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(cuid())
  username           String
  email              String          @unique
  password           String
  role               Role            @default(USER)
  createdAt          DateTime        @default(now())
  pfp                String          @default("")
  timeZone           String          @default("Asia/Karachi")
  dateFormat         String          @default("YYYY-MM-DD")

  logouts            Logout[]
  projects           Project[]

  createdTask        Task[]          @relation("CreatedTask")
  
  admin              Event[]        
  
  user               TeamMember[]    @relation("user")    
  byAdmin            TeamMember[]    @relation("admin")
  userNotification   Notification[]  @relation("userNotification")   
  adminNotification  Notification[]  @relation("adminNotification")
}


model TeamMember {
  id                String           @id @default(cuid())
  userId            String           
  adminId           String

  user              User             @relation("user", fields:[userId], references:[id])
  byAdmin           User             @relation("admin", fields:[adminId], references:[id])

  createdAt         DateTime          @default(now())

  
  projectmembers    ProjectMember[]
  assignedTask      Task[]             @relation("AssignedTask")
  member            EventMember[]

  @@unique([userId, adminId])
}


model Logout {
  id          String   @id @default(cuid())
  userId      String
  refreshHash String
  ip          String
  userAgent   String
  revoke      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  startDate      DateTime
  deadline       DateTime?
  createdAt      DateTime        @default(now())
  adminId        String
  status         ProjectStatus   @default(PENDING)
  completedAt    DateTime?
  admin          User            @relation(fields: [adminId], references: [id])
  projectmembers ProjectMember[]
  tasks          Task[]
  notification   Notification[]
  searchEmbedding  SearchEmbedding?
  @@index([adminId])
}

model ProjectMember {
  id              String         @id @default(cuid())
  teamMemberId    String
  projectId       String
  
  createdAt       DateTime       @default(now())

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            TeamMember     @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, projectId])
}

model Task {
  id           String          @id @default(cuid())
  name         String
  description  String?
  priority     Priority        @default(MEDIUM)
  status       TaskStatus      @default(TODO)
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String
  assignedToId String?
  projectId    String
  completedAt  DateTime?
  assignedTo   TeamMember?      @relation("AssignedTask", fields: [assignedToId], references: [id])
  createdBy    User             @relation("CreatedTask", fields: [createdById], references: [id])
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notification Notification[]
  searchEmbedding  SearchEmbedding?
  @@unique([projectId, name])
}

model Event {
  id            String     @id @default(cuid())
  name          String
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime   @default(now())

  adminId       String
  admin         User       @relation( fields:[adminId], references:[id])

  type          EventType

  eventMember   EventMember[]
  notification  Notification[]

}

model EventMember {
  id            String     @id @default(cuid())

  eventId       String
  memberId      String
  createdAt     DateTime   @default(now()) 
  event         Event      @relation( fields:[eventId], references:[id], onDelete:Cascade)
  member        TeamMember @relation( fields:[memberId], references:[id], onDelete:Cascade)

  @@unique([eventId, memberId])

}

model Notification {
  id               String       @id @default(cuid())
  userId           String
  adminId          String
  type             NotificationType
  title            String
  message          String
  isRead           Boolean      @default(false)

  projectId        String?
  taskId           String?
  eventId          String?

  createdAt        DateTime     @default(now())

  user             User         @relation("userNotification",fields:[userId], references:[id], onDelete:Cascade)
  admin            User         @relation("adminNotification", fields:[adminId], references:[id], onDelete:Cascade)
  project          Project?     @relation(fields:[projectId], references:[id], onDelete:Cascade)
  task             Task?        @relation(fields:[taskId], references:[id], onDelete:Cascade)
  event            Event?       @relation(fields:[eventId], references:[id], onDelete:Cascade)

  @@index([userId, createdAt, isRead])
  @@index([projectId])
  @@index([taskId])
  @@index([eventId])

}


model SearchEmbedding {
  id          String       @id @default(cuid())
  projectId   String?      @unique
  taskId      String?      @unique

  content     String
  embedding   Unsupported("vector(768)")
  embeddingModel  String   @default("gemini-embedding-2")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project?     @relation(fields:[projectId], references:[id], onDelete:Cascade)
  task        Task?        @relation(fields:[taskId], references:[id], onDelete:Cascade)

  @@index([updatedAt])

}


enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  PENDING
  ACTIVE
  COMPLETE
  CANCELLED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum EventType {
  PROJECT_MEETING
  DEADLINE
  PERSONAL_MEETING
}

enum NotificationType {
  PROJECT_CREATED
  PROJECT_UPDATED
  ADD_PROJECT_MEMBER
  PROJECT_COMPLETED
  PROJECT_DEADLINE
  TASK_ASSIGNED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_OVERDUE
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  EVENT_INVITATION
  EVENT_UPDATED
  EVENT_CANCELLED
  EVENT_REMINDER
}