generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(cuid())
  username       String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())


  logouts        Logout[]
  projects       Project[]

  createdTask    Task[]          @relation("CreatedTask")
  
  admin          Event[]        
  
  user           TeamMember[]    @relation("user")    
  byAdmin        TeamMember[]    @relation("admin")    
}


model TeamMember {
  id                String           @id @default(cuid())
  userId            String           
  adminId           String

  user              User             @relation("user", fields:[userId], references:[id])
  byAdmin           User             @relation("admin", fields:[adminId], references:[id])

  createdAt         DateTime          @default(now())

  
  projectmembers    ProjectMember[]
  assignedTask      Task[]             @relation("AssignedTask")
  member            EventMember[]

  @@unique([userId, adminId])
}


model Logout {
  id          String   @id @default(cuid())
  userId      String
  refreshHash String
  ip          String
  userAgent   String
  revoke      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  startDate      DateTime
  deadline       DateTime?
  createdAt      DateTime        @default(now())
  adminId        String
  status         ProjectStatus   @default(PENDING)
  completedAt    DateTime?
  admin          User            @relation(fields: [adminId], references: [id])
  projectmembers ProjectMember[]
  tasks          Task[]
}

model ProjectMember {
  id              String         @id @default(cuid())
  teamMemberId    String
  projectId       String
  
  createdAt       DateTime       @default(now())

  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            TeamMember     @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([teamMemberId, projectId])
}

model Task {
  id           String          @id @default(cuid())
  name         String
  description  String?
  priority     Priority        @default(MEDIUM)
  status       TaskStatus      @default(TODO)
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdById  String
  assignedToId String?
  projectId    String
  completedAt  DateTime?
  assignedTo   TeamMember?      @relation("AssignedTask", fields: [assignedToId], references: [id])
  createdBy    User             @relation("CreatedTask", fields: [createdById], references: [id])
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Event {
  id            String     @id @default(cuid())
  name          String
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  createdAt     DateTime   @default(now())

  adminId       String
  admin         User       @relation( fields:[adminId], references:[id])

  type          EventType

  eventMember   EventMember[]

}

model EventMember {
  id            String     @id @default(cuid())

  eventId       String
  memberId      String
  createdAt     DateTime   @default(now()) 
  event         Event      @relation( fields:[eventId], references:[id], onDelete:Cascade)
  member        TeamMember @relation( fields:[memberId], references:[id], onDelete:Cascade)

  @@unique([eventId, memberId])

}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  PENDING
  ACTIVE
  COMPLETE
  CANCELLED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum EventType{
  PROJECT_MEETING
  DEADLINE
  PERSONAL_MEETING
}